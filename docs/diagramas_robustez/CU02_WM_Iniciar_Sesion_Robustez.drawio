        </mxCell>
        <mxCell id="panel_legend" value="&lt;b&gt;ESTÁNDAR METODOLÓGICO ICONIX (UML 2.5) — REGLAS ESTRICTAS DE ROBUSTEZ:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Actores:&lt;/b&gt; Solo pueden comunicarse directamente con objetos &lt;b&gt;Boundary&lt;/b&gt; (Interfaz). Nunca con Control ni Entity.&lt;br/&gt;• &lt;b&gt;2. Boundary (Frontera):&lt;/b&gt; Recibe eventos de la UI y delega exclusivamente a &lt;b&gt;Control&lt;/b&gt;. &lt;i&gt;(Prohibido Boundary ➔ Entity)&lt;/i&gt;.&lt;br/&gt;• &lt;b&gt;3. Control (Lógica):&lt;/b&gt; Orquesta transacciones, reglas de negocio y delega a otros &lt;b&gt;Control&lt;/b&gt;, &lt;b&gt;Entity&lt;/b&gt; o responde a &lt;b&gt;Boundary&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;4. Entity (Datos):&lt;/b&gt; Representa el estado persistente (tablas de BD PostgreSQL). Solo es accedido y manipulado por &lt;b&gt;Control&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Arial;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=15;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="1620" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e01_usuario_login" value="1: Ingresar credenciales y enviar formulario" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.6;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="act_usuario" target="bnd_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
